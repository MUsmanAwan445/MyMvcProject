@model MyMvcProject.Models.WorkServiceFormViewModel

@{
    bool isEditMode = Model != null && Model.Id > 0;
    string actionToCall = isEditMode ? "Edit" : "Create";
    string buttonText = isEditMode ? "Update Record" : "Submit Record";
    string pageTitle = isEditMode ? "Edit Record" : "Create New Record";

    ViewData["Title"] = pageTitle;
}

<style>
    body {
        background-color: #f4f7f6;
    }
    .form-card {
        border-radius: 12px;
        border: none;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
        background-color: #ffffff;
        overflow: hidden;
    }
    .form-header {
        background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
        color: white;
        padding: 40px 20px;
        text-align: center;
        border-bottom: 5px solid #ffc107;
    }
    .form-header h2 {
        font-family: 'Times New Roman', Times, serif;
        font-weight: 700;
        letter-spacing: 1px;
        margin-bottom: 5px;
        text-shadow: 1px 1px 2px rgba(0,0,0,0.3);
    }
    .paper-input {
        border: none !important;
        border-bottom: 2px dashed #b0bec5 !important;
        border-radius: 0 !important;
        background-color: transparent !important;
        padding: 6px 12px !important;
        box-shadow: none !important;
        color: #1e3c72 !important;
        font-weight: 600;
        transition: all 0.3s ease;
    }
    .paper-input:focus {
        border-bottom: 2px solid #1e3c72 !important;
        background-color: #f8fafe !important;
        outline: none !important;
    }
    .section-title {
        color: #1e3c72;
        font-weight: 700;
        font-size: 1.2rem;
        margin-top: 40px;
        margin-bottom: 25px;
        padding-bottom: 10px;
        border-bottom: 2px solid #e9ecef;
        display: flex;
        align-items: center;
    }
    .section-icon {
        background-color: #e9ecef;
        color: #1e3c72;
        width: 35px;
        height: 35px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        margin-right: 12px;
        font-size: 1rem;
    }
    .highlight-box {
        background-color: #f8fafe;
        border-left: 4px solid #1e3c72;
        padding: 20px;
        border-radius: 6px;
        margin-bottom: 20px;
    }
    .custom-check {
        width: 1.25rem;
        height: 1.25rem;
        cursor: pointer;
        border-radius: 50% !important;
        -webkit-appearance: none;
        appearance: none;
        border: 2px solid #adb5bd;
        transition: 0.2s;
    }
    .custom-check:checked {
        background-color: #1e3c72;
        border-color: #1e3c72 !important;
        box-shadow: 0 0 0 3px rgba(30, 60, 114, 0.2);
    }
    .form-label-custom {
        font-weight: 600;
        color: #495057;
        margin-bottom: 0;
        white-space: nowrap;
    }
    .validation-text {
        font-size: 0.85rem;
        font-style: italic;
        margin-top: 4px;
        display: block;
    }
</style>

<div class="container my-5" style="max-width: 950px;">
    
    <div asp-validation-summary="All" class="text-danger fw-bold mb-4 bg-white p-3 rounded shadow-sm border-start border-danger border-4 validation-summary-errors d-none"></div>

    <div class="form-card">
        
        <div class="form-header">
            <h2>NATIONAL ELECTRONICS COMPLEX OF PAKISTAN</h2>
            <h5 class="mb-2 fw-light opacity-75">(Directorate of Works & Services)</h5>
            <div class="mt-3">
                <span class="badge bg-light text-dark px-3 py-2 rounded-pill shadow-sm" style="font-size: 0.9rem;">
                    <i class="bi bi-file-earmark-text me-1"></i> Process- W&S
                </span>
                @if(isEditMode)
                {
                    <span class="badge bg-warning text-dark px-3 py-2 rounded-pill shadow-sm ms-2" style="font-size: 0.9rem;">
                        <i class="bi bi-pencil-square me-1"></i> Editing Mode
                    </span>
                }
            </div>
        </div>

        <div class="card-body p-4 p-md-5">
            <!-- 🔥 enctype lagana zaroori hai file upload ke liye 🔥 -->
            <form asp-controller="WorkService" asp-action="@actionToCall" method="post" enctype="multipart/form-data" id="workServiceForm">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="ProfilePicPath" id="ProfilePicPathInput" />

                <!-- 🔥 PROFILE PICTURE UPLOAD SECTION 🔥 -->
                <div class="text-center mb-5 p-4 bg-light rounded shadow-sm border">
                    <div class="mb-3 position-relative d-inline-block">
                        <img id="profilePreview" 
                             src="@(!string.IsNullOrEmpty(Model?.ProfilePicPath) ? Model.ProfilePicPath : "/Images/default-user.png")" 
                             alt="Profile Picture" 
                             class="rounded-circle shadow" 
                             style="width: 130px; height: 130px; object-fit: cover; border: 4px solid #fff;" />
                    </div>
                    <div>
                        <label for="ProfileImage" class="btn btn-outline-primary btn-sm rounded-pill fw-bold px-3">
                            <i class="bi bi-camera-fill me-1"></i> Upload Profile Picture
                        </label>
                        <!-- Asli file input jo hidden hai, button se trigger hoga -->
                        <input asp-for="ProfileImage" type="file" id="ProfileImage" class="d-none" accept="image/*" />
                        <span asp-validation-for="ProfileImage" class="text-danger validation-text mt-1"></span>
                    </div>
                </div>

                <!-- Reference Number Section -->
                <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 p-3 bg-light rounded shadow-sm border">
                    <div class="fw-bold fs-5 text-dark mb-2 mb-md-0">
                        <i class="bi bi-bookmark-star-fill text-warning me-2"></i> Part B- Works & Services
                    </div>
                    <div class="d-flex align-items-end">
                        <span class="me-2 fw-bold text-secondary">Ref. No. W&S-20/JC/2018/</span>
                        <div>
                            <input asp-for="RefNo" class="form-control paper-input" style="width: 150px;" placeholder="e.g. 1234" />
                            <span asp-validation-for="RefNo" class="text-danger validation-text"></span>
                        </div>
                    </div>
                </div>

                <!-- SECTION 1 -->
                <div class="section-title">
                    <div class="section-icon"><i class="bi bi-1-circle-fill"></i></div>
                    Registration / Estimation
                </div>

                <div class="row g-4 mb-4">
                    <div class="col-md-12">
                        <div class="d-flex align-items-end">
                            <label class="me-3 form-label-custom">Recorded by: <span class="text-muted fw-normal">(JCM/CM)</span></label>
                            <input asp-for="RecordedBy" class="form-control paper-input flex-grow-1" />
                        </div>
                        <span asp-validation-for="RecordedBy" class="text-danger validation-text ms-md-4"></span>
                    </div>

                    <div class="col-md-12">
                        <div class="d-flex align-items-end">
                            <label class="me-3 form-label-custom">Officer Incharge: <span class="text-muted fw-normal">AM/Mgr (Electrical/HVAC/Civil)</span></label>
                            <input asp-for="OfficerIncharge" class="form-control paper-input flex-grow-1" />
                        </div>
                        <span asp-validation-for="OfficerIncharge" class="text-danger validation-text ms-md-4"></span>
                    </div>
                </div>

                <div class="row g-4 mb-4">
                    <div class="col-md-6">
                        <div class="d-flex align-items-end">
                            <label class="me-3 form-label-custom">Name Tasked:</label>
                            <input asp-for="NameTasked" class="form-control paper-input flex-grow-1" />
                        </div>
                        <span asp-validation-for="NameTasked" class="text-danger validation-text"></span>
                    </div>
                    
                    <div class="col-md-6">
                        <div class="d-flex align-items-end">
                            <label class="me-3 form-label-custom">Designation:</label>
                            <select asp-for="Designation" class="form-control paper-input flex-grow-1" asp-items="ViewBag.Designations">
                                <option value="">-- Select Designation --</option>
                            </select>
                        </div>
                        <span asp-validation-for="Designation" class="text-danger validation-text"></span>
                    </div>
                </div>

                <div class="row g-4 mb-4">
                    <div class="col-md-6">
                        <div class="d-flex align-items-end">
                            <label class="me-3 form-label-custom">Estimated Cost (Rs):</label>
                            <input asp-for="EstimatedCost" type="text" class="form-control paper-input flex-grow-1 fw-bold text-success" />
                        </div>
                        <span asp-validation-for="EstimatedCost" class="text-danger validation-text"></span>
                    </div>
                    
                    <div class="col-md-6">
                        <div class="d-flex align-items-end">
                            <label class="me-3 form-label-custom">Details attached at:</label>
                            <input asp-for="DetailsAttachedAt" class="form-control paper-input flex-grow-1" />
                        </div>
                        <span asp-validation-for="DetailsAttachedAt" class="text-danger validation-text"></span>
                    </div>
                </div>

                <div class="mb-4">
                    <div class="d-flex align-items-end">
                        <label class="me-3 form-label-custom">Verified by Officer Incharge:</label>
                        <input asp-for="VerifiedByOfficer" class="form-control paper-input flex-grow-1" style="max-width: 400px;" />
                    </div>
                    <span asp-validation-for="VerifiedByOfficer" class="text-danger validation-text ms-md-4"></span>
                </div>

                <div class="highlight-box">
                    <label class="form-label-custom mb-3 d-block text-dark"><i class="bi bi-box-seam me-2"></i>Store Status Verification:</label>
                    <div class="d-flex align-items-center flex-wrap gap-4">
                        <div class="form-check d-flex align-items-center">
                            <input asp-for="StoreStatus" type="radio" value="Available" class="form-check-input custom-check me-2 m-0" id="storeAvailable" />
                            <label class="form-check-label cursor-pointer fw-bold text-success" for="storeAvailable">Store Available</label>
                        </div>
                        <div class="form-check d-flex align-items-center">
                            <input asp-for="StoreStatus" type="radio" value="NotAvailable" class="form-check-input custom-check me-2 m-0" id="storeNotAvailable" />
                            <label class="form-check-label cursor-pointer fw-bold text-danger" for="storeNotAvailable">Not Available</label>
                        </div>
                    </div>
                    <span asp-validation-for="StoreStatus" class="text-danger validation-text mt-2"></span>
                </div>

                <div class="mb-4">
                    <div class="d-flex align-items-end">
                        <label class="me-3 form-label-custom">Recommendation: <span class="text-muted fw-normal">AM/Mgr (Electrical/HVAC/Civil)</span></label>
                        <input asp-for="Recommendation" class="form-control paper-input flex-grow-1" />
                    </div>
                    <span asp-validation-for="Recommendation" class="text-danger validation-text ms-md-4"></span>
                </div>

                <!-- SECTION 2 -->
                <div class="section-title">
                    <div class="section-icon"><i class="bi bi-2-circle-fill"></i></div>
                    Sanction Details
                </div>

                <div class="highlight-box">
                    <label class="form-label-custom mb-3 d-block text-dark"><i class="bi bi-cash-coin me-2"></i>Select Budget/Sanction Type:</label>
                    <div class="row g-3">
                        <div class="col-sm-6 col-md-3">
                            <div class="form-check d-flex align-items-center">
                                <input asp-for="SanctionType" type="radio" value="Imprest Advance" class="form-check-input custom-check me-2 m-0" id="sanc1" />
                                <label class="form-check-label cursor-pointer" for="sanc1">Imprest Advance</label>
                            </div>
                        </div>
                        <div class="col-sm-6 col-md-3">
                            <div class="form-check d-flex align-items-center">
                                <input asp-for="SanctionType" type="radio" value="W&S Budget" class="form-check-input custom-check me-2 m-0" id="sanc2" />
                                <label class="form-check-label cursor-pointer" for="sanc2">W&S Budget</label>
                            </div>
                        </div>
                        <div class="col-sm-6 col-md-3">
                            <div class="form-check d-flex align-items-center">
                                <input asp-for="SanctionType" type="radio" value="User Budget" class="form-check-input custom-check me-2 m-0" id="sanc3" />
                                <label class="form-check-label cursor-pointer" for="sanc3">User Budget</label>
                            </div>
                        </div>
                        <div class="col-sm-6 col-md-3">
                            <div class="form-check d-flex align-items-center">
                                <input asp-for="SanctionType" type="radio" value="Any Other Budget" class="form-check-input custom-check me-2 m-0" id="sanc4" />
                                <label class="form-check-label cursor-pointer" for="sanc4">Any Other Budget</label>
                            </div>
                        </div>
                    </div>
                    <span asp-validation-for="SanctionType" class="text-danger validation-text mt-2"></span>
                </div>

                <div class="mb-4">
                    <div class="d-flex align-items-end">
                        <label class="me-3 form-label-custom">Technical Sanction Dir(W&S):</label>
                        <input asp-for="TechnicalSanctionDir" class="form-control paper-input flex-grow-1" />
                    </div>
                    <span asp-validation-for="TechnicalSanctionDir" class="text-danger validation-text ms-md-4"></span>
                </div>

                <!-- SECTION 3 -->
                <div class="section-title">
                    <div class="section-icon"><i class="bi bi-3-circle-fill"></i></div>
                    Execution Phase
                </div>

                <div class="row g-4 mb-4">
                    <div class="col-md-6">
                        <div class="d-flex align-items-end">
                            <label class="me-3 form-label-custom">Officer Incharge:</label>
                            <input asp-for="ExecutionOfficerIncharge" class="form-control paper-input flex-grow-1" />
                        </div>
                        <span asp-validation-for="ExecutionOfficerIncharge" class="text-danger validation-text"></span>
                    </div>
                    
                    <div class="col-md-6">
                        <div class="d-flex align-items-end">
                            <label class="me-3 form-label-custom">Designation:</label>
                            <select asp-for="ExecutionOfficerDesignation" class="form-control paper-input flex-grow-1" asp-items="ViewBag.Designations">
                                <option value="">-- Select Designation --</option>
                            </select>
                        </div>
                        <span asp-validation-for="ExecutionOfficerDesignation" class="text-danger validation-text"></span>
                    </div>
                </div>

                <div class="row g-4 mb-4">
                    <div class="col-md-6">
                        <div class="d-flex align-items-end">
                            <label class="me-3 form-label-custom">Deployed Staff:</label>
                            <input asp-for="DeployedStaff" class="form-control paper-input flex-grow-1" />
                        </div>
                        <span asp-validation-for="DeployedStaff" class="text-danger validation-text"></span>
                    </div>
                    
                    <div class="col-md-6">
                        <div class="d-flex align-items-end">
                            <label class="me-3 form-label-custom">Designation:</label>
                            <select asp-for="DeployedStaffDesignation" class="form-control paper-input flex-grow-1" asp-items="ViewBag.Designations">
                                <option value="">-- Select Designation --</option>
                            </select>
                        </div>
                        <span asp-validation-for="DeployedStaffDesignation" class="text-danger validation-text"></span>
                    </div>
                </div>

                <!-- SECTION 4 -->
                <div class="section-title">
                    <div class="section-icon"><i class="bi bi-4-circle-fill"></i></div>
                    Recoupment / Redirect
                </div>

                <div class="mb-5">
                    <div class="d-flex align-items-end">
                        <label class="me-3 form-label-custom">Dir(W&S):</label>
                        <input asp-for="RecoupmentDirWS" class="form-control paper-input flex-grow-1" style="max-width: 400px;" />
                    </div>
                    <span asp-validation-for="RecoupmentDirWS" class="text-danger validation-text ms-md-4"></span>
                </div>

                <!-- Action Buttons -->
                <div class="d-flex justify-content-between mt-5 pt-4 border-top">
                    <a asp-action="List" class="btn btn-outline-secondary btn-lg px-4 py-2 rounded-pill fw-bold">
                        <i class="bi bi-arrow-left me-2"></i> Back to List
                    </a>
                    
                    @if(isEditMode)
                    {
                        <button type="submit" class="btn btn-warning btn-lg px-5 py-2 fw-bold shadow-sm rounded-pill">
                            <i class="bi bi-pencil-square me-2"></i> @buttonText
                        </button>
                    }
                    else
                    {
                        <button type="submit" class="btn btn-primary btn-lg px-5 py-2 fw-bold shadow-sm rounded-pill" style="background-color: #1e3c72; border-color: #1e3c72;">
                            <i class="bi bi-send-check-fill me-2"></i> @buttonText
                        </button>
                    }
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
        
        <script>
            $(document).ready(function () {
                // Validation summary handling
                if ($(".input-validation-error").length > 0) {
                    $(".validation-summary-errors").removeClass("d-none").hide().fadeIn(800);
                }

                // 🔥 AJAX Instant Image Upload Script 🔥
                $('#ProfileImage').change(function () {
                    var fileInput = this;
                    if (fileInput.files && fileInput.files[0]) {
                        var formData = new FormData();
                        formData.append("ProfileImage", fileInput.files[0]);

                        $.ajax({
                            url: '@Url.Action("UploadProfilePic", "WorkService")',
                            type: 'POST',
                            data: formData,
                            contentType: false,
                            processData: false,
                            success: function (response) {
                                if (response.success) {
                                    // Tasveer select hotay hi foran <img> tag update ho jaye ga
                                    $('#profilePreview').attr('src', response.imgPath);
                                    // Hidden input mein path set ho jaye ga taake form submit hone par database mein save ho sakay
                                    $('#ProfilePicPathInput').val(response.imgPath);
                                } else {
                                    alert("Error: " + response.message);
                                }
                            },
                            error: function () {
                                alert("Something went wrong while uploading the image.");
                            }
                        });
                    }
                });
            });
        </script>
    }
}