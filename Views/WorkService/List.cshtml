@model IEnumerable<MyMvcProject.Models.WorkServiceFormViewModel>

@{
    ViewData["Title"] = "All Forms List";
    int totalForms = Model != null ? Model.Count() : 0;
}

<div class="container-fluid my-5 px-4">
    
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4 rounded-3" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            <strong>Success!</strong> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Header Section with Total Count Badge, Search Box & Manage Button -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h2>Work & Services Forms Database</h2>
            <p class="text-muted mb-0">Total Submitted Records: <span class="badge bg-primary fs-6 px-3 py-1 rounded-pill">@totalForms</span></p>
        </div>

        <!-- Client-Side Live Search Input (Sirf Ref No, Recorded By, aur Name Tasked ke liye) -->
        <div class="input-group" style="max-width: 350px;">
            <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
            <input type="text" id="searchInput" class="form-control border-start-0 ps-0 shadow-none" placeholder="Search by Ref No, Recorded By, Name Tasked..." />
        </div>

        <div class="d-flex gap-2">
            <a asp-action="ManageDesignations" class="btn btn-warning px-3 py-2 fw-bold shadow-sm rounded-pill text-dark">
                <i class="bi bi-gear-fill me-1"></i> Manage Designations
            </a>
            <a asp-action="Create" class="btn btn-success px-4 py-2 fw-bold shadow-sm rounded-pill">
                <i class="bi bi-plus-lg me-1"></i> Add New Record
            </a>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped table-bordered mb-0" id="formsTable" style="white-space: nowrap;">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Ref No</th>
                            <th>Recorded By</th>
                            <th>Officer Incharge</th>
                            <th>Name Tasked</th>
                            <th>Designation</th>
                            <th>Estimated Cost</th>
                            <th>Details Attached At</th>
                            <th>Verified By</th>
                            <th>Store Status</th>
                            <th>Recommendation</th>
                            <th>Sanction Type</th>
                            <th>Tech Sanction Dir(W&S)</th>
                            <th>Exec Officer Incharge</th>
                            <th>Exec Officer Desig.</th>
                            <th>Deployed Staff</th>
                            <th>Deployed Staff Desig.</th>
                            <th>Recoupment Dir(W&S)</th>
                            <th>Submitted At</th>
                            <th>Profile Image</th>
                            <th class="text-center bg-dark text-white" style="position: sticky; right: 0; z-index: 2;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if(!Model.Any())
                        {
                            <tr>
                                <td colspan="21" class="text-center py-4 text-muted">No records found.</td>
                            </tr>
                        }
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="align-middle">@item.Id</td>
                                <!-- Ref No column with search class -->
                                <td class="align-middle fw-bold search-ref">@item.RefNo</td>
                                <!-- Recorded By column with search class -->
                                <td class="align-middle search-recorded">@item.RecordedBy</td>
                                <td class="align-middle">@item.OfficerIncharge</td>
                                <!-- Name Tasked column with search class -->
                                <td class="align-middle search-tasked">@item.NameTasked</td>
                                <td class="align-middle text-info fw-bold">@item.Designation</td>
                                <td class="align-middle text-success fw-bold">@item.EstimatedCost</td>
                                <td class="align-middle">@item.DetailsAttachedAt</td>
                                <td class="align-middle">@item.VerifiedByOfficer</td>
                                <td class="align-middle">
                                    @if(item.StoreStatus == "Available")
                                    {
                                        <span class="badge bg-success">@item.StoreStatus</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">@item.StoreStatus</span>
                                    }
                                </td>
                                <td class="align-middle">@item.Recommendation</td>
                                <td class="align-middle text-primary fw-bold">@item.SanctionType</td>
                                <td class="align-middle">@item.TechnicalSanctionDir</td>
                                <td class="align-middle">@item.ExecutionOfficerIncharge</td>
                                <td class="align-middle">@item.ExecutionOfficerDesignation</td>
                                <td class="align-middle">@item.DeployedStaff</td>
                                <td class="align-middle">@item.DeployedStaffDesignation</td>
                                <td class="align-middle">@item.RecoupmentDirWS</td>
                                <td class="align-middle">@item.SubmittedAt.ToString("dd-MMM-yyyy")</td>
                                <td class="align-middle text-center">
                                    @if (!string.IsNullOrEmpty(item.ProfilePicPath))
                                    {
                                        <img src="@item.ProfilePicPath" width="70" height="70" style="object-fit:cover;" />
                                    }
                                    else
                                    {
                                        <span class="text-muted">No Image</span>
                                    }
                                </td>
                                <td class="align-middle text-center bg-light" style="position: sticky; right: 0; box-shadow: -2px 0 5px rgba(0,0,0,0.1);">
                                    <div class="d-flex justify-content-center gap-2">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">
                                            Edit
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this record?');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                Delete
                                            </button>
                                        </form>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">View</a>
                                    </div>
                                </td>
                            </tr>
                        
                        
                        }

                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Client-side live search function targeting only specific columns (RefNo, RecordedBy, NameTasked)
        $(document).ready(function () {
            $("#searchInput").on("keyup", function () {
                var value = $(this).val().toLowerCase(); // User ka likha hua text lowercase mein convert karna

                $("#formsTable tbody tr").filter(function () {
                    // Sirf in teen columns ka text uthayega jo humne define kiye hain
                    var refNo = $(this).find(".search-ref").text().toLowerCase();
                    var recordedBy = $(this).find(".search-recorded").text().toLowerCase();
                    var nameTasked = $(this).find(".search-tasked").text().toLowerCase();

                    // Check karega ke user ka query in mein se kisi ek mein match hota hai ya nahi
                    var isMatch = refNo.indexOf(value) > -1 || 
                                  recordedBy.indexOf(value) > -1 || 
                                  nameTasked.indexOf(value) > -1;

                    // Match hone par row show hogi, warna hide ho jayegi
                    $(this).toggle(isMatch);
                });
            });
        });
    </script>
}